# SYPRUS environment example
# Copy to .env and fill in real values. Never commit .env.

# --- Database -------------------------------------------------------------
# Option A — local cluster with no Docker: `npm run db:pg`, then use this.
DATABASE_URL="postgresql://syprus:syprus_local_dev@localhost:55432/syprus"

# Option B — Supabase. Fill SUPABASE_DB_PASSWORD below, run `npm run check:supabase`,
# then paste the printed URI here. Use the DIRECT (session) endpoint for migrations;
# transaction pooling on 6543 cannot run `prisma migrate`.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require"
# DIRECT_DATABASE_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require"

# Used only by scripts/postgres.mjs (the embedded dev cluster).
PGPORT=55432
PGUSER=syprus
PGPASSWORD=syprus_local_dev
PGDATABASE=syprus

# --- Supabase (server-side only) -----------------------------------------
# Project Settings → General → Project ID / API keys → REST.
SUPABASE_PROJECT_REF=""
SUPABASE_URL="https://<project-ref>.supabase.co"
# service_role key. It bypasses Row Level Security: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# Settings → Database → Connection string → URI. This is the Postgres password,
# not the API key. Use "Reset database password" if it was never saved.
SUPABASE_DB_PASSWORD=""
# Optional pooled endpoint (Settings → Database → Connection pooling).
SUPABASE_POOLER_HOST=""
SUPABASE_POOLER_PORT=6543
SUPABASE_POOLER_USER="postgres.<project-ref>"

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- AI providers (server-side only) --------------------------------------
# Groq is the primary provider. The key is refused by any host outside
# ALLOWED_AI_HOSTS in src/lib/ai/config.ts, so a mis-set base URL cannot ship a
# credential somewhere it was not configured for. Enabled but uncredentialled
# runs fall back to the deterministic rule engines.
AI_ENABLED=true
AI_PROVIDER=openai-compatible
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_API_KEY=""
# Must be a model your key can actually use. Verified on this project:
#   openai/gpt-oss-120b  -> structured JSON output works
#   openai/gpt-oss-20b   -> fails JSON schema validation; do not use
AI_MODEL=openai/gpt-oss-120b
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=1600
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=3
AI_RATE_LIMIT_PER_MIN=30
# Groq enforces this per model on the free tier: 8,000 tokens/minute.
AI_TOKENS_PER_MINUTE=8000
AI_BUDGET_TOKENS_PER_DAY=2000000

# --- Failover providers (optional) ----------------------------------------
# Tried in order only when Groq is rate-limited, timed out, unreachable, or
# returned output that failed its own contract. Set AI_FAILOVER_ENABLED=false to
# make Groq-or-deterministic the only behaviour. The endpoint that answered is
# recorded in ai_runs.provider, so a failover is never reported as Groq.
AI_FAILOVER_ENABLED=true
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
GEMINI_API_KEY=""
GEMINI_MODEL=models/gemini-flash-lite-latest
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# Per-endpoint token windows, used to reserve before sending.
# OPENROUTER_TOKENS_PER_MINUTE=200000
# GEMINI_TOKENS_PER_MINUTE=100000
# Set to false for an endpoint that rejects response_format json_object.
# OPENROUTER_JSON_MODE=false
# GEMINI_JSON_MODE=false

# --- Mail: email verification codes ---------------------------------------
# Sign-up and every sign-in send a six-digit code, and no session exists until
# it is entered. SYPRUS holds no mail credential: it hands the letter to an Edge
# Function inside your own Supabase project, and that function holds the provider
# secret. The two values below are what a real send needs; with either missing, a
# real address is told "this server cannot send mail" and no code is issued — the
# flow fails closed rather than signing anyone in.
#
# Same SUPABASE_URL and service_role key as the Supabase block above, from
# Project Settings → API keys. Never commit it; never print it; never put either
# one in a NEXT_PUBLIC_ variable — this key bypasses Row Level Security, and the
# mail function checks that the caller presented it.
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# The function's slug. Deploy the one that ships with this repository:
#   npx supabase link --project-ref <project-ref>
#   npx supabase functions deploy send-email
#   npx supabase secrets set MAIL_FROM_ADDRESS="SYPRUS <no-reply@yourdomain>"
#   npx supabase secrets set RESEND_API_KEY=...        # or SMTP_HOST + friends
# SUPABASE_MAIL_FUNCTION=send-email
# Milliseconds to wait for the function before giving up (1000–30000).
# MAIL_TIMEOUT_MS=8000
#
# MAIL_FROM_ADDRESS belongs in the function's secrets, not in this app.
# Protect the service-role key too: it authorizes calls using that sender.
#
# MAIL_MODE picks where a code goes:
#   auto      (default) the Supabase function for real addresses; addresses on
#             example.com/.org/.net, syprus.test and localhost cannot receive mail
#             at all, so their code is shown on the entry screen under a
#             "Demonstration delivery — this code was not emailed" panel. That is
#             how the seeded accounts stay usable without a mail account.
#   supabase  never show a code on screen, whatever the address.
#   preview   show every code on screen and call the function not at all.
#             It turns the second factor into something anyone who can see the
#             monitor has. scripts/qa.ts pins this, so a test run can never put a
#             letter on the internet.
#
# Both on-screen paths above — `preview`, and `auto`'s reserved-domain branch —
# are ignored unless SYPRUS_DEMO_ENV below says this environment is disposable.
# Anywhere else the effective mode is `supabase`, so a code is never readable
# from the screen. This matters because the seeded administrator is itself a
# reserved-domain account: without the gate, anyone who knew the demonstration
# password could read its code off a public deployment's sign-in page.
# MAIL_MODE=auto
#
# Declares this environment disposable. It is required by every demonstration
# shortcut: the code waiver, on-screen verification codes, and the seed script.
# Set it on a local demo machine or an isolated test cluster and nowhere else.
# Vercel production is refused even if it is set, because VERCEL_ENV is injected
# by the platform rather than by this file.
SYPRUS_DEMO_ENV=false
#
# Set to true only on a machine whose purpose is demonstrating the seeded
# accounts, and only alongside SYPRUS_DEMO_ENV=true. It skips the code for
# addresses on the reserved example domains above — an account at a real domain
# still has to enter one — and the sign-in and registration screens say plainly
# that codes are switched off. Leave it false (the default) anywhere a real
# person has a real mailbox.
DEMO_SKIP_EMAIL_CODE=false
# How many codes one account may be sent in an hour (1-1000). Six is the product
# default and what a real deployment should keep. A shared test cluster that
# signs the same accounts in dozens of times needs it raised, which is exactly
# what scripts/qa.ts does — nowhere else.
# VERIFICATION_MAX_SENDS_PER_HOUR=6

# --- Seeding --------------------------------------------------------------
# Password applied to every seeded demonstration account, the administrator
# included. Required, at least 12 characters, and with no built-in fallback: a
# password committed here would be a published credential for those accounts.
SEED_DEMO_PASSWORD=""
# The seed deletes every table before writing, so it also needs this separate
# acknowledgement that the wipe is intended. Even with both flags it refuses any
# DATABASE_URL that is not a loopback host with a named database.
# `npm run qa:seed` sets both for the isolated QA cluster.
SEED_ALLOW_RESET=false

# --- Product configuration ------------------------------------------------
# Consent policy version stamped on every consent record.
POLICY_VERSION="2026-11-01"
# Version string recorded on every computed match, for fairness traceability.
MATCH_MODEL_VERSION="rules-2026-11-a"
